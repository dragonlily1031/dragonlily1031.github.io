{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport MtCard from \"@/components/MtCard.vue\";\nexport default {\n  components: {\n    MtCard\n  },\n  props: {\n    //\n  },\n  data: () => ({\n    height: 0,\n    width: 0,\n    pageHeight: 0,\n    pageWidth: 0,\n    menus: [{\n      title: \"Schedule\",\n      url: \"/assets/sea.png\"\n    }, {\n      title: \"Hotel\",\n      url: \"/assets/hotel.png\"\n    }, {\n      title: \"Emergency\",\n      url: \"/assets/usa.png\"\n    }]\n  }),\n  mounted: function () {\n    this.onResize();\n    let account = \"shoji\";\n    //let password = \"\";\n    alert(\"login\");\n    this.$axios.get(\"http://localhost:8080/login\", {\n      account: account\n    }).then(function (response) {\n      response.data;\n      alert(JSON.stringify(response.data));\n    }).catch(function (error) {\n      console.error(error);\n    });\n  },\n  computed: {\n    viewHeight: function () {\n      const toolberHeight = 48;\n      return this.pageHeight - toolberHeight;\n    }\n  },\n  methods: {\n    onResize: function () {\n      this.height = window.innerHeight;\n      this.width = window.innerWidth;\n      this.pageHeight = window.innerHeight - 12; // 上下6pxずつ取ってる\n      this.pageWidth = window.innerWidth - 12; // 左右6pxずつ取ってる\n    },\n    execute: function (title) {\n      if (title == \"Schedule\") this.$router.push({\n        name: \"schedule\"\n      });\n      if (title == \"Hotel\") window.open(\"https://www.miyakohybridhotel.com/miyako-jp/\");\n      if (title == \"Emergency\") this.$router.push({\n        name: \"emergency\"\n      });\n    }\n  }\n};","map":{"version":3,"names":["MtCard","components","props","data","height","width","pageHeight","pageWidth","menus","title","url","mounted","onResize","account","alert","$axios","get","then","response","JSON","stringify","catch","error","console","computed","viewHeight","toolberHeight","methods","window","innerHeight","innerWidth","execute","$router","push","name","open"],"sources":["C:\\work\\my-trip\\src\\pages\\MtLogin.vue"],"sourcesContent":["<!-- MtLogin.vue -->\r\n<template>\r\n  <div v-resize=\"onResize\" style=\"height: 100%; width: 100%; overflow: hidden\">\r\n    <!-- 下地 グレー -->\r\n    <MtCard\r\n      flat\r\n      color=\"#999999\"\r\n      style=\"overflow: hidden\"\r\n      :height=\"height\"\r\n      :width=\"width\"\r\n    >\r\n      <!-- 下地 ホワイト -->\r\n      <MtCard\r\n        style=\"margin: 6px; overflow: hidden\"\r\n        :height=\"pageHeight\"\r\n        :width=\"pageWidth\"\r\n      >\r\n        <!-- メイン下地 ホワイト -->\r\n        <MtCard\r\n          flat\r\n          style=\"overflow: auto\"\r\n          :height=\"viewHeight\"\r\n          :width=\"pageWidth\"\r\n        >\r\n          <!-- メニュー -->\r\n        </MtCard>\r\n      </MtCard>\r\n    </MtCard>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport MtCard from \"@/components/MtCard.vue\";\r\n\r\nexport default {\r\n  components: {\r\n    MtCard,\r\n  },\r\n  props: {\r\n    //\r\n  },\r\n  data: () => ({\r\n    height: 0,\r\n    width: 0,\r\n    pageHeight: 0,\r\n    pageWidth: 0,\r\n\r\n    menus: [\r\n      {\r\n        title: \"Schedule\",\r\n        url: \"/assets/sea.png\",\r\n      },\r\n      {\r\n        title: \"Hotel\",\r\n        url: \"/assets/hotel.png\",\r\n      },\r\n      {\r\n        title: \"Emergency\",\r\n        url: \"/assets/usa.png\",\r\n      },\r\n    ],\r\n  }),\r\n  mounted: function () {\r\n    this.onResize();\r\n    let account = \"shoji\";\r\n    //let password = \"\";\r\n    alert(\"login\");\r\n    this.$axios\r\n      .get(\"http://localhost:8080/login\", { account: account })\r\n      .then(function (response) {\r\n        response.data;\r\n        alert(JSON.stringify(response.data));\r\n      })\r\n      .catch(function (error) {\r\n        console.error(error);\r\n      });\r\n  },\r\n  computed: {\r\n    viewHeight: function () {\r\n      const toolberHeight = 48;\r\n      return this.pageHeight - toolberHeight;\r\n    },\r\n  },\r\n  methods: {\r\n    onResize: function () {\r\n      this.height = window.innerHeight;\r\n      this.width = window.innerWidth;\r\n      this.pageHeight = window.innerHeight - 12; // 上下6pxずつ取ってる\r\n      this.pageWidth = window.innerWidth - 12; // 左右6pxずつ取ってる\r\n    },\r\n    execute: function (title) {\r\n      if (title == \"Schedule\") this.$router.push({ name: \"schedule\" });\r\n\r\n      if (title == \"Hotel\")\r\n        window.open(\"https://www.miyakohybridhotel.com/miyako-jp/\");\r\n\r\n      if (title == \"Emergency\") this.$router.push({ name: \"emergency\" });\r\n    },\r\n  },\r\n};\r\n</script>\r\n"],"mappings":";AAgCA,OAAOA,MAAK,MAAO,yBAAyB;AAE5C,eAAe;EACbC,UAAU,EAAE;IACVD;EACF,CAAC;EACDE,KAAK,EAAE;IACL;EAAA,CACD;EACDC,IAAI,EAAEA,CAAA,MAAO;IACXC,MAAM,EAAE,CAAC;IACTC,KAAK,EAAE,CAAC;IACRC,UAAU,EAAE,CAAC;IACbC,SAAS,EAAE,CAAC;IAEZC,KAAK,EAAE,CACL;MACEC,KAAK,EAAE,UAAU;MACjBC,GAAG,EAAE;IACP,CAAC,EACD;MACED,KAAK,EAAE,OAAO;MACdC,GAAG,EAAE;IACP,CAAC,EACD;MACED,KAAK,EAAE,WAAW;MAClBC,GAAG,EAAE;IACP,CAAC;EAEL,CAAC,CAAC;EACFC,OAAO,EAAE,SAAAA,CAAA,EAAY;IACnB,IAAI,CAACC,QAAQ,CAAC,CAAC;IACf,IAAIC,OAAM,GAAI,OAAO;IACrB;IACAC,KAAK,CAAC,OAAO,CAAC;IACd,IAAI,CAACC,MAAK,CACPC,GAAG,CAAC,6BAA6B,EAAE;MAAEH,OAAO,EAAEA;IAAQ,CAAC,EACvDI,IAAI,CAAC,UAAUC,QAAQ,EAAE;MACxBA,QAAQ,CAACf,IAAI;MACbW,KAAK,CAACK,IAAI,CAACC,SAAS,CAACF,QAAQ,CAACf,IAAI,CAAC,CAAC;IACtC,CAAC,EACAkB,KAAK,CAAC,UAAUC,KAAK,EAAE;MACtBC,OAAO,CAACD,KAAK,CAACA,KAAK,CAAC;IACtB,CAAC,CAAC;EACN,CAAC;EACDE,QAAQ,EAAE;IACRC,UAAU,EAAE,SAAAA,CAAA,EAAY;MACtB,MAAMC,aAAY,GAAI,EAAE;MACxB,OAAO,IAAI,CAACpB,UAAS,GAAIoB,aAAa;IACxC;EACF,CAAC;EACDC,OAAO,EAAE;IACPf,QAAQ,EAAE,SAAAA,CAAA,EAAY;MACpB,IAAI,CAACR,MAAK,GAAIwB,MAAM,CAACC,WAAW;MAChC,IAAI,CAACxB,KAAI,GAAIuB,MAAM,CAACE,UAAU;MAC9B,IAAI,CAACxB,UAAS,GAAIsB,MAAM,CAACC,WAAU,GAAI,EAAE,EAAE;MAC3C,IAAI,CAACtB,SAAQ,GAAIqB,MAAM,CAACE,UAAS,GAAI,EAAE,EAAE;IAC3C,CAAC;IACDC,OAAO,EAAE,SAAAA,CAAUtB,KAAK,EAAE;MACxB,IAAIA,KAAI,IAAK,UAAU,EAAE,IAAI,CAACuB,OAAO,CAACC,IAAI,CAAC;QAA