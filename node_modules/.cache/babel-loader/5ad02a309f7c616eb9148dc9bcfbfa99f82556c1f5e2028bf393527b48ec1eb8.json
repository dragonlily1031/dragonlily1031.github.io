ult) {\r\n        alert(\"result\");\r\n        this.loading = false;\r\n      } else {\r\n        location.reload();\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.mainlogin {\r\n  background: linear-gradient(-225deg, #2cd8d5 0%, #c5c1ff 50%, #ffbac3 100%);\r\n}\r\n.loginWindow {\r\n  display: inline-flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  border-radius: 12px;\r\n}\r\n.login-dialog {\r\n  opacity: 0.9;\r\n}\r\n</style>\r\n"],"mappings":"AAsCA,OAAOA,MAAK,MAAO,yBAAyB;AAC5C,OAAOC,WAAU,MAAO,8BAA8B;AACtD,OAAOC,mBAAkB,MAAO,sCAAsC;AAEtE,eAAe;EACbC,UAAU,EAAE;IACVH,MAAM;IACNC,WAAW;IACXC;EACF,CAAC;EACDE,KAAK,EAAE;IACL;EAAA,CACD;EACDC,IAAI,EAAEA,CAAA,MAAO;IACXC,MAAM,EAAE,CAAC;IACTC,KAAK,EAAE,CAAC;IACRC,SAAS,EAAE,GAAG;IACdC,SAAS,EAAE,EAAE;IACbC,OAAO,EAAE,EAAE;IACXC,QAAQ,EAAE,EAAE;IACZC,OAAO,EAAE;EACX,CAAC,CAAC;EACFC,OAAO,EAAE,eAAAA,CAAA,EAAkB;IACzB;EAAA,CACD;EACDC,QAAQ,EAAE;IACRC,cAAc,EAAE,SAAAA,CAAA,EAAY;MAC1B;MACA,OAAO,mCAAmC;IAC5C,CAAC;IACDC,IAAI,EAAE,SAAAA,CAAA,EAAY;MAChB,OAAOC,OAAO,CAACC,GAAG,CAACC,QAAO,GAAI,iBAAiB;IACjD;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,KAAK,EAAE,eAAAA,CAAA,EAAkB;MACvB,IAAI,CAACT,OAAM,GAAI,IAAI;MACnB,IAAIU,MAAK,GAAI,KAAK;MAClB,MAAM,IAAI,CAACC,MAAM,CAACC,IAAG,CAClBH,KAAK,CAAC,IAAI,CAACX,OAAO,EAAE,IAAI,CAACC,QAAQ,EACjCc,IAAI,CAAEC,QAAQ,IAAMJ,MAAK,GAAII,QAAQ,CAACrB,IAAK,EAC3CsB,KAAK,CAAEC,GAAG,IACTC,KAAK,CAAC,QAAO,GAAIC,IAAI,CAACC,SAAS,CAACH,GAAG,CAACF,QAAQ,CAACrB,IAAI,CAAC2B,OAAO,CAAC,CAC5D,CAAC;MAEH,IAAIV,MAAM,EAAE;QACVO,KAAK,CAAC,QAAQ,CAAC;QACf,IAAI,CAACjB,OAAM,GAAI,KAAK;MACtB,OAAO;QACLqB,QAAQ,CAACC,MAAM,CAAC,CAAC;MACnB;IACF;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}