{"ast":null,"code":"import MtCard from \"@/components/MtCard.vue\";\nimport MtTextField from \"@/components/MtTextFieldSetBase.vue\";\nexport default {\n  components: {\n    MtCard,\n    MtTextField\n  },\n  props: {\n    //\n  },\n  data: () => ({\n    height: 0,\n    width: 0,\n    pageHeight: 0,\n    pageWidth: 0,\n    password: \"\"\n  }),\n  mounted: async function () {\n    this.onResize();\n  },\n  computed: {\n    viewHeight: function () {\n      const toolberHeight = 48;\n      return this.pageHeight - toolberHeight;\n    }\n  },\n  methods: {\n    onResize: function () {\n      this.height = window.innerHeight;\n      this.width = window.innerWidth;\n      this.pageHeight = window.innerHeight - 12; // 上下6pxずつ取ってる\n      this.pageWidth = window.innerWidth - 12; // 左右6pxずつ取ってる\n    },\n    login: function () {\n      alert(\"login \" + this.password);\n    }\n  }\n};","map":{"version":3,"names":["MtCard","MtTextField","components","props","data","height","width","pageHeight","pageWidth","password","mounted","onResize","computed","viewHeight","toolberHeight","methods","window","innerHeight","innerWidth","login","alert"],"sources":["C:\\work\\my-trip\\src\\pages\\MtLoginPage.vue"],"sourcesContent":["<!-- MtLoginPage.vue -->\r\n<template>\r\n  <div v-resize=\"onResize\" style=\"height: 100%; width: 100%; overflow: hidden\">\r\n    <!-- 下地 グレー -->\r\n    <MtCard\r\n      flat\r\n      color=\"#999999\"\r\n      style=\"overflow: hidden\"\r\n      :height=\"height\"\r\n      :width=\"width\"\r\n    >\r\n      <!-- 下地 ホワイト -->\r\n      <MtCard\r\n        style=\"margin: 6px; overflow: hidden\"\r\n        :height=\"pageHeight\"\r\n        :width=\"pageWidth\"\r\n      >\r\n        <!-- メイン下地 ホワイト -->\r\n        <MtCard\r\n          flat\r\n          style=\"overflow: auto\"\r\n          :height=\"viewHeight\"\r\n          :width=\"pageWidth\"\r\n        >\r\n          <!-- ログインフォーム -->\r\n          <MtTextField\r\n            passwordTextField\r\n            v-model=\"password\"\r\n            name=\"password\"\r\n            label=\"Password\"\r\n            class=\"mb-4\"\r\n          ></MtTextField>\r\n        </MtCard>\r\n      </MtCard>\r\n    </MtCard>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport MtCard from \"@/components/MtCard.vue\";\r\nimport MtTextField from \"@/components/MtTextFieldSetBase.vue\";\r\n\r\nexport default {\r\n  components: {\r\n    MtCard,\r\n    MtTextField,\r\n  },\r\n  props: {\r\n    //\r\n  },\r\n  data: () => ({\r\n    height: 0,\r\n    width: 0,\r\n    pageHeight: 0,\r\n    pageWidth: 0,\r\n    password: \"\",\r\n  }),\r\n  mounted: async function () {\r\n    this.onResize();\r\n  },\r\n  computed: {\r\n    viewHeight: function () {\r\n      const toolberHeight = 48;\r\n      return this.pageHeight - toolberHeight;\r\n    },\r\n  },\r\n  methods: {\r\n    onResize: function () {\r\n      this.height = window.innerHeight;\r\n      this.width = window.innerWidth;\r\n      this.pageHeight = window.innerHeight - 12; // 上下6pxずつ取ってる\r\n      this.pageWidth = window.innerWidth - 12; // 左右6pxずつ取ってる\r\n    },\r\n    login: function () {\r\n      alert(\"login \" + this.password);\r\n    },\r\n  },\r\n};\r\n</script>\r\n"],"mappings":"AAuCA,OAAOA,MAAK,MAAO,yBAAyB;AAC5C,OAAOC,WAAU,MAAO,qCAAqC;AAE7D,eAAe;EACbC,UAAU,EAAE;IACVF,MAAM;IACNC;EACF,CAAC;EACDE,KAAK,EAAE;IACL;EAAA,CACD;EACDC,IAAI,EAAEA,CAAA,MAAO;IACXC,MAAM,EAAE,CAAC;IACTC,KAAK,EAAE,CAAC;IACRC,UAAU,EAAE,CAAC;IACbC,SAAS,EAAE,CAAC;IACZC,QAAQ,EAAE;EACZ,CAAC,CAAC;EACFC,OAAO,EAAE,eAAAA,CAAA,EAAkB;IACzB,IAAI,CAACC,QAAQ,CAAC,CAAC;EACjB,CAAC;EACDC,QAAQ,EAAE;IACRC,UAAU,EAAE,SAAAA,CAAA,EAAY;MACtB,MAAMC,aAAY,GAAI,EAAE;MACxB,OAAO,IAAI,CAACP,UAAS,GAAIO,aAAa;IACxC;EACF,CAAC;EACDC,OAAO,EAAE;IACPJ,QAAQ,EAAE,SAAAA,CAAA,EAAY;MACpB,IAAI,CAACN,MAAK,GAAIW,MAAM,CAACC,WAAW;MAChC,IAAI,CAACX,KAAI,GAAIU,MAAM,CAACE,UAAU;MAC9B,IAAI,CAACX,UAAS,GAAIS,MAAM,CAACC,WAAU,GAAI,EAAE,EAAE;MAC3C,IAAI,CAACT,SAAQ,GAAIQ,MAAM,CAACE,UAAS,GAAI,EAAE,EAAE;IAC3C,CAAC;IACDC,KAAK,EAAE,SAA