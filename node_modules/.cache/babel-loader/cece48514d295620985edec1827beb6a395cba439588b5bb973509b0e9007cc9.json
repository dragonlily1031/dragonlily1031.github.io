{"ast":null,"code":"import MtCard from \"@/components/MtCard.vue\";\nimport MtTextField from \"@/components/MtTextField.vue\";\nimport MtPasswordTextField from \"@/components/MtPasswordTextField.vue\";\nexport default {\n  components: {\n    MtCard,\n    MtTextField,\n    MtPasswordTextField\n  },\n  props: {\n    //\n  },\n  data: () => ({\n    height: 0,\n    width: 0,\n    pageHeight: 0,\n    pageWidth: 0,\n    viewHeight: 0,\n    viewWidth: 0,\n    account: \"\",\n    password: \"\",\n    loading: false\n  }),\n  mounted: async function () {\n    this.onResize();\n  },\n  computed: {\n    //\n  },\n  methods: {\n    onResize: function () {\n      this.height = window.innerHeight;\n      this.width = window.innerWidth;\n      this.pageHeight = window.innerHeight - 12; // 上下6pxずつ取ってる\n      this.pageWidth = window.innerWidth - 12; // 左右6pxずつ取ってる\n      this.viewHeight = this.pageWidth * 0.8;\n      this.viewWidth = this.pageWidth * 0.8;\n    },\n    login: async function () {\n      this.loading = true;\n      let result = false;\n      await this.$mtapi.auth.login(this.account, this.password).then(response => result = response.data).catch(err => alert(\"error \" + JSON.stringify(err.response.data.message)));\n      if (result) {\n        alert(\"result\");\n        this.loading = false;\n      } else {\n        location.reload();\n      }\n    }\n  }\n};","map":{"version":3,"names":["MtCard","MtTextField","MtPasswordTextField","components","props","data","height","width","pageHeight","pageWidth","viewHeight","viewWidth","account","password","loading","mounted","onResize","computed","methods","window","innerHeight","innerWidth","login","result","$mtapi","auth","then","response","catch","err","alert","JSON","stringify","message","location","reload"],"sources":["C:\\work\\my-trip\\src\\pages\\MtLoginPage.vue"],"sourcesContent":["<!-- MtLoginPage.vue -->\r\n<template>\r\n  <v-main style=\"radial-gradient(#c8cadb, #5084bd) fixed height: 100%\">\r\n    <v-container fluid fill-height>\r\n      <div\r\n        v-resize=\"onResize\"\r\n        style=\"height: 100%; width: 100%; overflow: hidden\"\r\n      >\r\n        <!-- メイン下地 ホワイト -->\r\n        <MtCard\r\n          elevation=\"8\"\r\n          :height=\"viewHeight\"\r\n          :width=\"viewWidth\"\r\n          class=\"mx-auto\"\r\n          style=\"padding: 36px\"\r\n        >\r\n          <!-- ログインフォーム -->\r\n          <v-form @submit.prevent=\"login\">\r\n            <MtTextField\r\n              v-model=\"account\"\r\n              outlined\r\n              label=\"account\"\r\n              prepend-icon=\"mdi-account\"\r\n              style=\"padding: 100px 0px 16px 0px\"\r\n            />\r\n            <MtPasswordTextField\r\n              v-model=\"password\"\r\n              label=\"password\"\r\n              style=\"padding-bottom: 30px\"\r\n            />\r\n            <v-btn\r\n              :loading=\"loading\"\r\n              color=\"success\"\r\n              size=\"large\"\r\n              type=\"submit\"\r\n              variant=\"elevated\"\r\n              block\r\n            >\r\n              LOGIN\r\n            </v-btn>\r\n          </v-form>\r\n        </MtCard>\r\n      </div>\r\n    </v-container>\r\n  </v-main>\r\n</template>\r\n\r\n<script>\r\nimport MtCard from \"@/components/MtCard.vue\";\r\nimport MtTextField from \"@/components/MtTextField.vue\";\r\nimport MtPasswordTextField from \"@/components/MtPasswordTextField.vue\";\r\n\r\nexport default {\r\n  components: {\r\n    MtCard,\r\n    MtTextField,\r\n    MtPasswordTextField,\r\n  },\r\n  props: {\r\n    //\r\n  },\r\n  data: () => ({\r\n    height: 0,\r\n    width: 0,\r\n    pageHeight: 0,\r\n    pageWidth: 0,\r\n    viewHeight: 0,\r\n    viewWidth: 0,\r\n    account: \"\",\r\n    password: \"\",\r\n    loading: false,\r\n  }),\r\n  mounted: async function () {\r\n    this.onResize();\r\n  },\r\n  computed: {\r\n    //\r\n  },\r\n  methods: {\r\n    onResize: function () {\r\n      this.height = window.innerHeight;\r\n      this.width = window.innerWidth;\r\n      this.pageHeight = window.innerHeight - 12; // 上下6pxずつ取ってる\r\n      this.pageWidth = window.innerWidth - 12; // 左右6pxずつ取ってる\r\n      this.viewHeight = this.pageWidth * 0.8;\r\n      this.viewWidth = this.pageWidth * 0.8;\r\n    },\r\n    login: async function () {\r\n      this.loading = true;\r\n      let result = false;\r\n      await this.$mtapi.auth\r\n        .login(this.account, this.password)\r\n        .then((response) => (result = response.data))\r\n        .catch((err) =>\r\n          alert(\"error \" + JSON.stringify(err.response.data.message))\r\n        );\r\n\r\n      if (result) {\r\n        alert(\"result\");\r\n        this.loading = false;\r\n      } else {\r\n        location.reload();\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n"],"mappings":"AAgDA,OAAOA,MAAK,MAAO,yBAAyB;AAC5C,OAAOC,WAAU,MAAO,8BAA8B;AACtD,OAAOC,mBAAkB,MAAO,sCAAsC;AAEtE,eAAe;EACbC,UAAU,EAAE;IACVH,MAAM;IACNC,WAAW;IACXC;EACF,CAAC;EACDE,KAAK,EAAE;IACL;EAAA,CACD;EACDC,IAAI,EAAEA,CAAA,MAAO;IACXC,MAAM,EAAE,CAAC;IACTC,KAAK,EAAE,CAAC;IACRC,UAAU,EAAE,CAAC;IACbC,SAAS,EAAE,CAAC;IACZC,UAAU,EAAE,CAAC;IACbC,SAAS,EAAE,CAAC;IACZC,OAAO,EAAE,EAAE;IACXC,QAAQ,EAAE,EAAE;IACZC,OAAO,EAAE;EACX,CAAC,CAAC;EACFC,OAAO,EAAE,eAAAA,CAAA,EAAkB;IACzB,IAAI,CAACC,QAAQ,CAAC,CAAC;EACjB,CAAC;EACDC,QAAQ,EAAE;IACR;EAAA,CACD;EACDC,OAAO,EAAE;IACPF,QAAQ,EAAE,SAAAA,CAAA,EAAY;MACpB,IAAI,CAACV,MAAK,GAAIa,MAAM,CAACC,WAAW;MAChC,IAAI,CAACb,KAAI,GAAIY,MAAM,CAACE,UAAU;MAC9B,IAAI,CAACb,UAAS,GAAIW,MAAM,CAACC,WAAU,GAAI,EAAE,EAAE;MAC3C,IAAI,CAACX,SAAQ,GAAIU,MAAM,CAACE,UAAS,GAAI,EAAE,EAAE;MACzC,IAAI,CAACX,UAAS,GAAI,IAAI,CAACD,SAAQ,GAAI,GAAG;MACtC,IAAI,CAACE,SAAQ,GAAI,IAAI,CAACF,SAAQ,GAAI,GAAG;IACvC,CAAC;IACDa,KAAK,EAAE,eAAAA,CAAA,EAAkB;MACvB,IAAI,CAACR,OAAM,GAAI,IAAI;MACnB,IAAIS,MAAK,GAAI,KAAK;MAClB,MAAM,IAAI,CAACC,MAAM,CAACC,IAAG,CAClBH,KAAK,CAAC,IAAI,CAACV,OAAO,EAAE,IAAI,CAACC,QAAQ,EACjCa,IAAI,CAAEC,QAAQ,IAAMJ,MAAK,GAAII,QAAQ,CAACtB,IAAK,EAC3CuB,KAAK,CA