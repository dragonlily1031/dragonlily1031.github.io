{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport MtToolbar from \"@/components/MtToolbar.vue\";\nimport MtCard from \"@/components/MtCard.vue\";\nexport default {\n  components: {\n    MtToolbar,\n    MtCard\n  },\n  props: {\n    //\n  },\n  data: () => ({\n    isInitialized: false,\n    height: window.innerHeight,\n    width: window.innerWidth,\n    menus: [{\n      title: \"Hotel\",\n      url: \"https://cdn.vuetifyjs.com/images/cards/plane.jpg\"\n    }, {\n      title: \"Emergency\",\n      url: \"https://cdn.vuetifyjs.com/images/cards/plane.jpg\"\n    }]\n  }),\n  created: async function () {\n    this.isInitialized = true;\n  },\n  mounted: async function () {\n    this.onResize();\n  },\n  computed: {\n    pageHeight: function () {\n      const pageHeight = this.height - 24; // 上下12pxずつ取ってる\n      return pageHeight;\n    },\n    // ページの幅（Naviの開閉状態に依存する）\n    pageWidth: function () {\n      const marginOfVContainer = 12; // 上下左右とも12px\n      const globalNaviBarWidth = this.isNaviExpanded ? 280 : 70;\n      const pageWidth = this.width - marginOfVContainer * 2 - globalNaviBarWidth;\n      return pageWidth;\n    },\n    viewHeight: function () {\n      const toolberHeight = 64;\n      const toolberMargin = 8;\n      return this.pageHeight - toolberHeight - toolberMargin;\n    }\n  },\n  methods: {\n    onResize: function () {\n      this.pageHeight = this.height - 24; // 上下12pxずつ取ってる\n      this.pageWidth = this.width - 24; // 左右12pxずつ取ってる\n    },\n    execute: function (title) {\n      if (title == \"Schedule\") this.$router.push({\n        name: \"schedule\"\n      });\n      if (title == \"Hotel\") window.open(\"https://www.miyakohybridhotel.com/miyako-jp/\");\n      if (title == \"Emergency\") this.$router.push({\n        name: \"emergency\"\n      });\n    }\n  }\n};","map":{"version":3,"names":["MtToolbar","MtCard","components","props","data","isInitialized","height","window","innerHeight","width","innerWidth","menus","title","url","created","mounted","onResize","computed","pageHeight","pageWidth","marginOfVContainer","globalNaviBarWidth","isNaviExpanded","viewHeight","toolberHeight","toolberMargin","methods","execute","$router","push","name","open"],"sources":["C:\\work\\my-trip\\src\\pages\\MtHomePage.vue"],"sourcesContent":["<!-- MtHomePage.vue -->\r\n<template>\r\n  <div style=\"height: 100%; width: 100%; overflow: hidden\">\r\n    <div\r\n      v-if=\"isInitialized\"\r\n      v-resize=\"onResize\"\r\n      style=\"height: 100%; width: 100%; overflow: hidden\"\r\n    >\r\n      <MtToolbar title=\"Home\" :elevation=\"6\" isHome></MtToolbar>\r\n\r\n      <!-- 下地 グレー -->\r\n      <v-main style=\"background-color: #999999\">\r\n        <v-container fluid>\r\n          <MtCard\r\n            color=\"red\"\r\n            style=\"overflow: hidden\"\r\n            :height=\"pageHeight\"\r\n            :width=\"pageWidth\"\r\n          >\r\n          </MtCard>\r\n        </v-container>\r\n      </v-main>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport MtToolbar from \"@/components/MtToolbar.vue\";\r\nimport MtCard from \"@/components/MtCard.vue\";\r\n\r\nexport default {\r\n  components: {\r\n    MtToolbar,\r\n    MtCard,\r\n  },\r\n  props: {\r\n    //\r\n  },\r\n  data: () => ({\r\n    isInitialized: false,\r\n    height: window.innerHeight,\r\n    width: window.innerWidth,\r\n\r\n    menus: [\r\n      {\r\n        title: \"Hotel\",\r\n        url: \"https://cdn.vuetifyjs.com/images/cards/plane.jpg\",\r\n      },\r\n      {\r\n        title: \"Emergency\",\r\n        url: \"https://cdn.vuetifyjs.com/images/cards/plane.jpg\",\r\n      },\r\n    ],\r\n  }),\r\n  created: async function () {\r\n    this.isInitialized = true;\r\n  },\r\n  mounted: async function () {\r\n    this.onResize();\r\n  },\r\n  computed: {\r\n    pageHeight: function () {\r\n      const pageHeight = this.height - 24; // 上下12pxずつ取ってる\r\n      return pageHeight;\r\n    },\r\n    // ページの幅（Naviの開閉状態に依存する）\r\n    pageWidth: function () {\r\n      const marginOfVContainer = 12; // 上下左右とも12px\r\n      const globalNaviBarWidth = this.isNaviExpanded ? 280 : 70;\r\n      const pageWidth =\r\n        this.width - marginOfVContainer * 2 - globalNaviBarWidth;\r\n      return pageWidth;\r\n    },\r\n    viewHeight: function () {\r\n      const toolberHeight = 64;\r\n      const toolberMargin = 8;\r\n      return this.pageHeight - toolberHeight - toolberMargin;\r\n    },\r\n  },\r\n  methods: {\r\n    onResize: function () {\r\n      this.pageHeight = this.height - 24; // 上下12pxずつ取ってる\r\n      this.pageWidth = this.width - 24; // 左右12pxずつ取ってる\r\n    },\r\n    execute: function (title) {\r\n      if (title == \"Schedule\") this.$router.push({ name: \"schedule\" });\r\n\r\n      if (title == \"Hotel\")\r\n        window.open(\"https://www.miyakohybridhotel.com/miyako-jp/\");\r\n\r\n      if (title == \"Emergency\") this.$router.push({ name: \"emergency\" });\r\n    },\r\n  },\r\n};\r\n</script>\r\n"],"mappings":";AA2BA,OAAOA,SAAQ,MAAO,4BAA4B;AAClD,OAAOC,MAAK,MAAO,yBAAyB;AAE5C,eAAe;EACbC,UAAU,EAAE;IACVF,SAAS;IACTC;EACF,CAAC;EACDE,KAAK,EAAE;IACL;EAAA,CACD;EACDC,IAAI,EAAEA,CAAA,MAAO;IACXC,aAAa,EAAE,KAAK;IACpBC,MAAM,EAAEC,MAAM,CAACC,WAAW;IAC1BC,KAAK,EAAEF,MAAM,CAACG,UAAU;IAExBC,KAAK,EAAE,CACL;MACEC,KAAK,EAAE,OAAO;MACdC,GAAG,EAAE;IACP,CAAC,EACD;MACED,KAAK,EAAE,WAAW;MAClBC,GAAG,EAAE;IACP,CAAC;EAEL,CAAC,CAAC;EACFC,OAAO,EAAE,eAAAA,CAAA,EAAkB;IACzB,IAAI,CAACT,aAAY,GAAI,IAAI;EAC3B,CAAC;EACDU,OAAO,EAAE,eAAAA,CAAA,EAAkB;IACzB,IAAI,CAACC,QAAQ,CAAC,CAAC;EACjB,CAAC;EACDC,QAAQ,EAAE;IACRC,UAAU,EAAE,SAAAA,CAAA,EAAY;MACtB,MAAMA,UAAS,GAAI,IAAI,CAACZ,MAAK,GAAI,EAAE,EAAE;MACrC,OAAOY,UAAU;IACnB,CAAC;IACD;IACAC,SAAS,EAAE,SAAAA,CAAA,EAAY;MACrB,MAAMC,kBAAiB,GAAI,EAAE,EAAE;MAC/B,MAAMC,kBAAiB,GAAI,IAAI,CAACC,cAAa,GAAI,GAAE,GAAI,EAAE;MACzD,MAAMH,SAAQ,GACZ,IAAI,CAACV,KAAI,GAAIW,kBAAiB,GAAI,IAAIC,kBAAkB;MAC1D,OAAOF,SAAS;IAClB,CAAC;IACDI,UAAU,EAAE,SAAAA,CAAA,EAAY;MACtB,MAAMC,aAAY,GAAI,EAAE;MACxB,MAAMC,aAAY,GAAI,CAA