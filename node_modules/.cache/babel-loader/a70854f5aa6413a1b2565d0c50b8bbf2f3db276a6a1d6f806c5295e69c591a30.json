{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport MtToolbar from \"@/components/MtToolbar.vue\";\nimport MtCard from \"@/components/MtCard.vue\";\nexport default {\n  components: {\n    MtToolbar,\n    MtCard\n  },\n  props: {\n    //\n  },\n  data: () => ({\n    height: 0,\n    width: 0,\n    pageHeight: 0,\n    pageWidth: 0,\n    menus: [{\n      title: \"Schedule\",\n      url: \"https://cdn.vuetifyjs.com/images/cards/house.jpg\",\n      flex: 12\n    }, {\n      title: \"Hotel\",\n      url: \"https://cdn.vuetifyjs.com/images/cards/road.jpg\",\n      flex: 6\n    }, {\n      title: \"Emergency\",\n      url: \"https://cdn.vuetifyjs.com/images/cards/plane.jpg\",\n      flex: 6\n    }]\n  }),\n  mounted: async function () {\n    this.onResize();\n  },\n  computed: {\n    viewHeight: function () {\n      const toolberHeight = 48;\n      return this.pageHeight - toolberHeight;\n    }\n  },\n  methods: {\n    onResize: function () {\n      this.height = window.innerHeight;\n      this.width = window.innerWidth;\n      this.pageHeight = window.innerHeight - 12; // 上下6pxずつ取ってる\n      this.pageWidth = window.innerWidth - 12; // 左右6pxずつ取ってる\n    },\n    execute: function (title) {\n      if (title == \"Schedule\") this.$router.push({\n        name: \"schedule\"\n      });\n      if (title == \"Hotel\") window.open(\"https://www.miyakohybridhotel.com/miyako-jp/\");\n      if (title == \"Emergency\") this.$router.push({\n        name: \"emergency\"\n      });\n    }\n  }\n};","map":{"version":3,"names":["MtToolbar","MtCard","components","props","data","height","width","pageHeight","pageWidth","menus","title","url","flex","mounted","onResize","computed","viewHeight","toolberHeight","methods","window","innerHeight","innerWidth","execute","$router","push","name","open"],"sources":["C:\\work\\my-trip\\src\\pages\\MtHomePage.vue"],"sourcesContent":["<!-- MtHomePage.vue -->\r\n<template>\r\n  <div v-resize=\"onResize\" style=\"height: 100%; width: 100%; overflow: hidden\">\r\n    <!-- 下地 グレー -->\r\n    <MtCard\r\n      flat\r\n      color=\"#999999\"\r\n      style=\"overflow: hidden\"\r\n      :height=\"height\"\r\n      :width=\"width\"\r\n    >\r\n      <!-- 下地 ホワイト -->\r\n      <MtCard\r\n        style=\"margin: 6px; overflow: hidden\"\r\n        :height=\"pageHeight\"\r\n        :width=\"pageWidth\"\r\n      >\r\n        <!-- メイン下地 ホワイト -->\r\n        <MtToolbar title=\"Home\" :elevation=\"6\" isHome></MtToolbar>\r\n        <MtCard\r\n          flat\r\n          style=\"overflow: auto\"\r\n          :height=\"viewHeight\"\r\n          :width=\"pageWidth\"\r\n        >\r\n          <!-- メニュー -->\r\n          <v-container fluid>\r\n            <v-row dense>\r\n              <v-col\r\n                v-for=\"(menu, index) in menus\"\r\n                :key=\"index\"\r\n                :cols=\"menu.flex\"\r\n              >\r\n                <MtCard :elevation=\"8\" @click=\"execute(menu.title)\">\r\n                  <v-img\r\n                    :src=\"menu.url\"\r\n                    height=\"300px\"\r\n                    gradient=\"to bottom, rgba(0,0,0,.1), rgba(0,0,0,.5)\"\r\n                  >\r\n                    <v-card-title class=\"white--text align-end\">{{\r\n                      menu.title\r\n                    }}</v-card-title>\r\n                  </v-img>\r\n\r\n                  <v-card-actions>\r\n                    <v-btn icon>\r\n                      <v-icon>mdi-heart</v-icon>\r\n                    </v-btn>\r\n\r\n                    <v-btn icon>\r\n                      <v-icon>mdi-bookmark</v-icon>\r\n                    </v-btn>\r\n\r\n                    <v-btn icon>\r\n                      <v-icon>mdi-share-variant</v-icon>\r\n                    </v-btn>\r\n                  </v-card-actions>\r\n                </MtCard>\r\n              </v-col>\r\n            </v-row>\r\n          </v-container>\r\n        </MtCard>\r\n      </MtCard>\r\n    </MtCard>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport MtToolbar from \"@/components/MtToolbar.vue\";\r\nimport MtCard from \"@/components/MtCard.vue\";\r\n\r\nexport default {\r\n  components: {\r\n    MtToolbar,\r\n    MtCard,\r\n  },\r\n  props: {\r\n    //\r\n  },\r\n  data: () => ({\r\n    height: 0,\r\n    width: 0,\r\n    pageHeight: 0,\r\n    pageWidth: 0,\r\n\r\n    menus: [\r\n      {\r\n        title: \"Schedule\",\r\n        url: \"https://cdn.vuetifyjs.com/images/cards/house.jpg\",\r\n        flex: 12,\r\n      },\r\n      {\r\n        title: \"Hotel\",\r\n        url: \"https://cdn.vuetifyjs.com/images/cards/road.jpg\",\r\n        flex: 6,\r\n      },\r\n      {\r\n        title: \"Emergency\",\r\n        url: \"https://cdn.vuetifyjs.com/images/cards/plane.jpg\",\r\n        flex: 6,\r\n      },\r\n    ],\r\n  }),\r\n  mounted: async function () {\r\n    this.onResize();\r\n  },\r\n  computed: {\r\n    viewHeight: function () {\r\n      const toolberHeight = 48;\r\n      return this.pageHeight - toolberHeight;\r\n    },\r\n  },\r\n  methods: {\r\n    onResize: function () {\r\n      this.height = window.innerHeight;\r\n      this.width = window.innerWidth;\r\n      this.pageHeight = window.innerHeight - 12; // 上下6pxずつ取ってる\r\n      this.pageWidth = window.innerWidth - 12; // 左右6pxずつ取ってる\r\n    },\r\n    execute: function (title) {\r\n      if (title == \"Schedule\") this.$router.push({ name: \"schedule\" });\r\n\r\n      if (title == \"Hotel\")\r\n        window.open(\"https://www.miyakohybridhotel.com/miyako-jp/\");\r\n\r\n      if (title == \"Emergency\") this.$router.push({ name: \"emergency\" });\r\n    },\r\n  },\r\n};\r\n</script>\r\n"],"mappings":";AAoEA,OAAOA,SAAQ,MAAO,4BAA4B;AAClD,OAAOC,MAAK,MAAO,yBAAyB;AAE5C,eAAe;EACbC,UAAU,EAAE;IACVF,SAAS;IACTC;EACF,CAAC;EACDE,KAAK,EAAE;IACL;EAAA,CACD;EACDC,IAAI,EAAEA,CAAA,MAAO;IACXC,MAAM,EAAE,CAAC;IACTC,KAAK,EAAE,CAAC;IACRC,UAAU,EAAE,CAAC;IACbC,SAAS,EAAE,CAAC;IAEZC,KAAK,EAAE,CACL;MACEC,KAAK,EAAE,UAAU;MACjBC,GAAG,EAAE,kDAAkD;MACvDC,IAA