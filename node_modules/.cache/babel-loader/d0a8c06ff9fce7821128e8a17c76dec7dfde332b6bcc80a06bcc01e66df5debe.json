{"ast":null,"code":"import MtCard from \"@/components/MtCard.vue\";\nimport MtTextFieldSet from \"@/components/MtTextFieldSet.vue\";\nexport default {\n  components: {\n    MtCard,\n    MtTextFieldSet\n  },\n  props: {\n    //\n  },\n  data: () => ({\n    height: 0,\n    width: 0,\n    pageHeight: 0,\n    pageWidth: 0,\n    loading: false,\n    password: \"\"\n  }),\n  mounted: async function () {\n    this.onResize();\n  },\n  computed: {\n    viewHeight: function () {\n      const toolberHeight = 48;\n      return this.pageHeight - toolberHeight;\n    }\n  },\n  methods: {\n    onResize: function () {\n      this.height = window.innerHeight;\n      this.width = window.innerWidth;\n      this.pageHeight = window.innerHeight - 12; // 上下6pxずつ取ってる\n      this.pageWidth = window.innerWidth - 12; // 左右6pxずつ取ってる\n    },\n    login() {\n      this.loading = true;\n      alert(this.password);\n    }\n  }\n};","map":{"version":3,"names":["MtCard","MtTextFieldSet","components","props","data","height","width","pageHeight","pageWidth","loading","password","mounted","onResize","computed","viewHeight","toolberHeight","methods","window","innerHeight","innerWidth","login","alert"],"sources":["C:\\work\\my-trip\\src\\pages\\MtLoginPage.vue"],"sourcesContent":["<!-- MtLoginPage.vue -->\r\n<template>\r\n  <div v-resize=\"onResize\" style=\"height: 100%; width: 100%; overflow: hidden\">\r\n    <!-- 下地 グレー -->\r\n    <MtCard\r\n      flat\r\n      color=\"#999999\"\r\n      style=\"overflow: hidden\"\r\n      :height=\"height\"\r\n      :width=\"width\"\r\n    >\r\n      <!-- 下地 ホワイト -->\r\n      <MtCard\r\n        style=\"margin: 6px; overflow: hidden\"\r\n        :height=\"pageHeight\"\r\n        :width=\"pageWidth\"\r\n      >\r\n        <!-- メイン下地 ホワイト -->\r\n        <MtCard\r\n          flat\r\n          style=\"overflow: auto\"\r\n          :height=\"viewHeight\"\r\n          :width=\"pageWidth\"\r\n        >\r\n          <!-- ログインフォーム -->\r\n          <v-form v-model=\"form\" @submit.prevent=\"login\">\r\n            <MtTextFieldSet\r\n              v-model=\"account\"\r\n              prepend-icon=\"person\"\r\n              name=\"account\"\r\n              :type=\"'email'\"\r\n              :readonly=\"isDisplayWindowsAuthLogin\"\r\n              :autofocus=\"!isDisplayWindowsAuthLogin\"\r\n              class=\"mb-4\"\r\n              :style=\"LOGIN_FORM_STYLE\"\r\n            />\r\n            <MtTextFieldSet passwordTextField v-model=\"password\" />\r\n            <v-btn\r\n              :loading=\"loading\"\r\n              color=\"success\"\r\n              size=\"large\"\r\n              type=\"submit\"\r\n              variant=\"elevated\"\r\n              block\r\n            >\r\n              LOGIN\r\n            </v-btn>\r\n          </v-form>\r\n        </MtCard>\r\n      </MtCard>\r\n    </MtCard>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport MtCard from \"@/components/MtCard.vue\";\r\nimport MtTextFieldSet from \"@/components/MtTextFieldSet.vue\";\r\n\r\nexport default {\r\n  components: {\r\n    MtCard,\r\n    MtTextFieldSet,\r\n  },\r\n  props: {\r\n    //\r\n  },\r\n  data: () => ({\r\n    height: 0,\r\n    width: 0,\r\n    pageHeight: 0,\r\n    pageWidth: 0,\r\n    loading: false,\r\n    password: \"\",\r\n  }),\r\n  mounted: async function () {\r\n    this.onResize();\r\n  },\r\n  computed: {\r\n    viewHeight: function () {\r\n      const toolberHeight = 48;\r\n      return this.pageHeight - toolberHeight;\r\n    },\r\n  },\r\n  methods: {\r\n    onResize: function () {\r\n      this.height = window.innerHeight;\r\n      this.width = window.innerWidth;\r\n      this.pageHeight = window.innerHeight - 12; // 上下6pxずつ取ってる\r\n      this.pageWidth = window.innerWidth - 12; // 左右6pxずつ取ってる\r\n    },\r\n    login() {\r\n      this.loading = true;\r\n      alert(this.password);\r\n    },\r\n  },\r\n};\r\n</script>\r\n"],"mappings":"AAuDA,OAAOA,MAAK,MAAO,yBAAyB;AAC5C,OAAOC,cAAa,MAAO,iCAAiC;AAE5D,eAAe;EACbC,UAAU,EAAE;IACV