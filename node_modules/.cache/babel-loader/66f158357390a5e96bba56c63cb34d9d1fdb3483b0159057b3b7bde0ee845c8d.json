{"ast":null,"code":"import MtCard from \"@/components/MtCard.vue\";\nexport default {\n  components: {\n    MtCard\n  },\n  props: {\n    //\n  },\n  data: () => ({\n    height: 0,\n    width: 0,\n    pageHeight: 0,\n    pageWidth: 0,\n    account: \"\",\n    password: \"\",\n    showPassword: false,\n    rules: {\n      required: value => !!value || \"Required.\",\n      min: v => v.length >= 8 || \"Min 8 characters\",\n      emailMatch: () => `The email and password you entered don't match`\n    }\n  }),\n  mounted: async function () {\n    this.onResize();\n  },\n  computed: {\n    viewHeight: function () {\n      const toolberHeight = 48;\n      return this.pageHeight - toolberHeight;\n    }\n  },\n  methods: {\n    onResize: function () {\n      this.height = window.innerHeight;\n      this.width = window.innerWidth;\n      this.pageHeight = window.innerHeight - 12; // 上下6pxずつ取ってる\n      this.pageWidth = window.innerWidth - 12; // 左右6pxずつ取ってる\n    }\n  }\n};","map":{"version":3,"names":["MtCard","components","props","data","height","width","pageHeight","pageWidth","account","password","showPassword","rules","required","value","min","v","length","emailMatch","mounted","onResize","computed","viewHeight","toolberHeight","methods","window","innerHeight","innerWidth"],"sources":["C:\\work\\my-trip\\src\\pages\\MtLoginPage.vue"],"sourcesContent":["<!-- MtLoginPage.vue -->\r\n<template>\r\n  <div v-resize=\"onResize\" style=\"height: 100%; width: 100%; overflow: hidden\">\r\n    <!-- 下地 グレー -->\r\n    <MtCard\r\n      flat\r\n      color=\"#999999\"\r\n      style=\"overflow: hidden\"\r\n      :height=\"height\"\r\n      :width=\"width\"\r\n    >\r\n      <!-- 下地 ホワイト -->\r\n      <MtCard\r\n        style=\"margin: 6px; overflow: hidden\"\r\n        :height=\"pageHeight\"\r\n        :width=\"pageWidth\"\r\n      >\r\n        <!-- メイン下地 ホワイト -->\r\n        <MtCard\r\n          flat\r\n          style=\"overflow: auto\"\r\n          :height=\"viewHeight\"\r\n          :width=\"pageWidth\"\r\n        >\r\n          <!-- ログインフォーム -->\r\n          <v-text-field\r\n            v-model=\"password\"\r\n            type=\"password\"\r\n            :append-icon=\"showPassword ? 'mdi-eye' : 'mdi-eye-off'\"\r\n            label=\"Password\"\r\n            @click:append=\"showPassword = !showPassword\"\r\n          />\r\n        </MtCard>\r\n      </MtCard>\r\n    </MtCard>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport MtCard from \"@/components/MtCard.vue\";\r\n\r\nexport default {\r\n  components: {\r\n    MtCard,\r\n  },\r\n  props: {\r\n    //\r\n  },\r\n  data: () => ({\r\n    height: 0,\r\n    width: 0,\r\n    pageHeight: 0,\r\n    pageWidth: 0,\r\n    account: \"\",\r\n    password: \"\",\r\n    showPassword: false,\r\n\r\n    rules: {\r\n      required: (value) => !!value || \"Required.\",\r\n      min: (v) => v.length >= 8 || \"Min 8 characters\",\r\n      emailMatch: () => `The email and password you entered don't match`,\r\n    },\r\n  }),\r\n  mounted: async function () {\r\n    this.onResize();\r\n  },\r\n  computed: {\r\n    viewHeight: function () {\r\n      const toolberHeight = 48;\r\n      return this.pageHeight - toolberHeight;\r\n    },\r\n  },\r\n  methods: {\r\n    onResize: function () {\r\n      this.height = window.innerHeight;\r\n      this.width = window.innerWidth;\r\n      this.pageHeight = window.innerHeight - 12; // 上下6pxずつ取ってる\r\n      this.pageWidth = window.innerWidth - 12; // 左右6pxずつ取ってる\r\n    },\r\n  },\r\n};\r\n</script>\r\n"],"mappings":"AAuCA,OAAOA,MAAK,MAAO,yBAAyB;AAE5C,eAAe;EACbC,UAAU,EAAE;IACVD;EACF,CAAC;EACDE,KAAK,EAAE;IACL;EAAA,CACD;EACDC,IAAI,EAAEA,CAAA,MAAO;IACXC,MAAM,EAAE,CAAC;IACTC,KAAK,EAAE,CAAC;IACRC,UAAU,EAAE,CAAC;IACbC,SAAS,EAAE,CAAC;IACZC,OAAO,EAAE,EAAE;IACXC,QAAQ,EAAE,EAAE;IACZC,YAAY,EAAE,KAAK;IAEnBC,KAAK,EAAE;MACLC,QAAQ,EAAGC,KAAK,IAAK,CAAC,CAACA,KAAI,IAAK,WAAW;MAC3CC,GAAG,EAAGC,CAAC,IAAKA,CAAC,CAACC,MAAK,IAAK,KAAK,kBAAkB;MAC/CC,UAAU,EAAEA,CAAA,KAAM;IACpB;EACF,CAAC,CAAC;EACFC,OAA