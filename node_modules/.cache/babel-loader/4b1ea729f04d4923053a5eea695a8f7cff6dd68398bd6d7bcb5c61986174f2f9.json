{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport MtToolbar from \"@/components/MtToolbar.vue\";\nimport MtCard from \"@/components/MtCard.vue\";\nexport default {\n  components: {\n    MtToolbar,\n    MtCard\n  },\n  props: {\n    //\n  },\n  data: () => ({\n    isInitialized: false,\n    height: window.innerHeight,\n    width: window.innerWidth,\n    viewHeight: 0,\n    menus: [{\n      title: \"Hotel\",\n      url: \"https://cdn.vuetifyjs.com/images/cards/plane.jpg\"\n    }, {\n      title: \"Emergency\",\n      url: \"https://cdn.vuetifyjs.com/images/cards/plane.jpg\"\n    }]\n  }),\n  created: async function () {\n    this.isInitialized = true;\n  },\n  mounted: async function () {\n    this.onResize();\n  },\n  computed: {\n    pageHeight: function () {\n      const toolberHeight = 64;\n      const pageHeight = this.height - toolberHeight; // 上下12pxずつ余白取ってるらしい\n      return pageHeight;\n    },\n    pageWidth: function () {\n      const pageWidth = this.width - 24; // 左右12pxずつ取ってるらしいけど、widthだけなんか余白が違う\n      return pageWidth;\n    }\n  },\n  methods: {\n    onResize: function (event) {\n      // F5\n      if (!event) return;\n\n      // window.dispatchEvent(new Event(\"resize\"));から呼び出された時\n      if (!event.isTrusted) return;\n      this.height = window.innerHeight;\n      this.width = window.innerWidth;\n      this.viewHeight = this.pageHeight;\n    },\n    execute: function (title) {\n      if (title == \"Schedule\") this.$router.push({\n        name: \"schedule\"\n      });\n      if (title == \"Hotel\") window.open(\"https://www.miyakohybridhotel.com/miyako-jp/\");\n      if (title == \"Emergency\") this.$router.push({\n        name: \"emergency\"\n      });\n    }\n  }\n};","map":{"version":3,"names":["MtToolbar","MtCard","components","props","data","isInitialized","height","window","innerHeight","width","innerWidth","viewHeight","menus","title","url","created","mounted","onResize","computed","pageHeight","toolberHeight","pageWidth","methods","event","isTrusted","execute","$router","push","name","open"],"sources":["C:\\work\\my-trip\\src\\pages\\MtHomePage.vue"],"sourcesContent":["<!-- MtHomePage.vue -->\r\n<template>\r\n  <v-layout>\r\n    <div style=\"height: 100%; width: 100%; overflow: hidden\">\r\n      <div\r\n        v-if=\"isInitialized\"\r\n        v-resize=\"onResize\"\r\n        style=\"height: 100%; width: 100%; overflow: hidden\"\r\n      >\r\n        <MtToolbar title=\"Home\" isHome></MtToolbar>\r\n\r\n        <v-main>\r\n          <!-- 下地 グレー -->\r\n          <MtCard\r\n            color=\"#eeeeee\"\r\n            style=\"overflow: hidden\"\r\n            :height=\"pageHeight\"\r\n            :width=\"width\"\r\n          >\r\n            <!-- メイン下地 ホワイト -->\r\n            <MtCard\r\n              flat\r\n              style=\"margin: 8px; overflow: auto\"\r\n              :height=\"viewHeight\"\r\n              :width=\"pageWidth\"\r\n            >\r\n              <!-- メニュー Top -->\r\n              <MtCard\r\n                :elevation=\"8\"\r\n                style=\"margin: 8px\"\r\n                @click=\"execute(item.title)\"\r\n              >\r\n                <v-img\r\n                  src=\"https://cdn.vuetifyjs.com/images/cards/house.jpg\"\r\n                  class=\"align-end\"\r\n                  height=\"200px\"\r\n                  gradient=\"to bottom, rgba(0,0,0,.1), rgba(0,0,0,.5)\"\r\n                >\r\n                  <v-card-title class=\"font-weight-bold text-white\">\r\n                    schedule\r\n                  </v-card-title>\r\n                </v-img>\r\n              </MtCard>\r\n\r\n              <!-- メニュー Sub -->\r\n              <div class=\"d-flex flex-wrap\">\r\n                <div v-for=\"(item, index) in menus\" :key=\"index\">\r\n                  <MtCard\r\n                    :elevation=\"8\"\r\n                    style=\"margin: 8px\"\r\n                    @click=\"execute(item.title)\"\r\n                  >\r\n                    <v-img\r\n                      :src=\"item.url\"\r\n                      class=\"align-end\"\r\n                      gradient=\"to bottom, rgba(0,0,0,.1), rgba(0,0,0,.5)\"\r\n                    >\r\n                      <v-card-title class=\"font-weight-bold text-white\">\r\n                        {{ item.title }}\r\n                      </v-card-title>\r\n                    </v-img>\r\n                  </MtCard>\r\n                </div>\r\n              </div>\r\n            </MtCard>\r\n          </MtCard>\r\n        </v-main>\r\n      </div>\r\n    </div>\r\n  </v-layout>\r\n</template>\r\n\r\n<script>\r\nimport MtToolbar from \"@/components/MtToolbar.vue\";\r\nimport MtCard from \"@/components/MtCard.vue\";\r\n\r\nexport default {\r\n  components: {\r\n    MtToolbar,\r\n    MtCard,\r\n  },\r\n  props: {\r\n    //\r\n  },\r\n  data: () => ({\r\n    isInitialized: false,\r\n    height: window.innerHeight,\r\n    width: window.innerWidth,\r\n    viewHeight: 0,\r\n\r\n    menus: [\r\n      {\r\n        title: \"Hotel\",\r\n        url: \"https://cdn.vuetifyjs.com/images/cards/plane.jpg\",\r\n      },\r\n      {\r\n        title: \"Emergency\",\r\n        url: \"https://cdn.vuetifyjs.com/images/cards/plane.jpg\",\r\n      },\r\n    ],\r\n  }),\r\n  created: async function () {\r\n    this.isInitialized = true;\r\n  },\r\n  mounted: async function () {\r\n    this.onResize();\r\n  },\r\n  computed: {\r\n    pageHeight: function () {\r\n      const toolberHeight = 64;\r\n      const pageHeight = this.height - toolberHeight; // 上下12pxずつ余白取ってるらしい\r\n      return pageHeight;\r\n    },\r\n    pageWidth: function () {\r\n      const pageWidth = this.width - 24; // 左右12pxずつ取ってるらしいけど、widthだけなんか余白が違う\r\n      return pageWidth;\r\n    },\r\n  },\r\n  methods: {\r\n    onResize: function (event) {\r\n      // F5\r\n      if (!event) return;\r\n\r\n      // window.dispatchEvent(new Event(\"resize\"));から呼び出された時\r\n      if (!event.isTrusted) return;\r\n\r\n      this.height = window.innerHeight;\r\n      this.width = window.innerWidth;\r\n      this.viewHeight = this.pageHeight;\r\n    },\r\n    execute: function (title) {\r\n      if (title == \"Schedule\") this.$router.push({ name: \"schedule\" });\r\n\r\n      if (title == \"Hotel\")\r\n        window.open(\"https://www.miyakohybridhotel.com/miyako-jp/\");\r\n\r\n      if (title == \"Emergency\") this.$router.push({ name: \"emergency\" });\r\n    },\r\n  },\r\n};\r\n</script>\r\n"],"mappings":";AAyEA,OAAOA,SAAQ,MAAO,4BAA4B;AAClD,OAAOC,MAAK,MAAO,yBAAyB;AAE5C,eAAe;EACbC,UAAU,EAAE;IACVF,SAAS;IACTC;EACF,CAAC;EACDE,KAAK,EAAE;IACL;EAAA,CACD;EACDC,IAAI,EAAEA,CAAA,MAAO;IACXC,aAAa,EAAE,KAAK;IACpBC,MAAM,EAAEC,MAAM,CAACC,WAAW;IAC1BC,KAAK,EAAEF,MAAM,CAACG,UAAU;IACxBC,UAAU,EAAE,CAAC;IAEbC,KAAK,EAAE,CACL;MACEC,KAAK,EAAE,OAAO;MACdC,GAAG,EAAE;IACP,CAAC,EACD;MACED,KAAK,EAAE,WAAW;MAClBC,GAAG,EAAE;IACP,CAAC;EAEL,CAAC,CAAC;EACFC,OAAO,EAAE,eAAAA,CAAA,EAAkB;IACzB,IAAI,CAACV,aAAY,GAAI,IAAI;EAC3B,CAAC;EACDW,OAAO,EAAE,eAAAA,CAAA,EAAkB;IACzB,IAAI,CAACC,QAAQ,CAAC,CAAC;EACjB,CAAC;EACDC,QAAQ,EAAE;IACRC,UAAU,EAAE,SAAAA,CAAA,EAAY;MACtB,MAAMC,aAAY,GAAI,EAAE;MACxB,MAAMD,UAAS,GAAI,IAAI,CAACb,MAAK,GAAIc,aAAa,EAAE;MAChD,OAAOD,UAAU;IACnB,CAAC;IACDE,SAAS,EAAE,SAAAA,CAAA,EAAY;MACrB,MAAMA,SAAQ,GAAI,IAAI,CAACZ,KAAI,GAAI,EAAE,EAAE;MACnC,OAAOY,SAAS;IAClB;EACF,CAAC;EACDC,OAAO,EAAE;IACPL,QAAQ,EAAE,SAAAA,CAAUM,KAAK,EAAE;MACzB;MACA,IAAI,CAACA,KAAK,EAAE;;MAEZ;MACA,IAAI,CAACA,KAAK,CAACC,SAAS,EAAE;MAEtB,IAAI,CAAClB,MAAK,GAAIC,MAAM,CAACC,WAAW;MAChC,IAAI,CAACC,KAAI,GAAIF,MAAM,CAACG,UAAU;MAC9B,IAAI,CAACC,UAAS,GAAI,IAAI,CAACQ,UAAU;IACnC,CAAC;IACDM,OAAO,EAAE,SAAAA,CAAUZ,KAAK,EAAE;MACxB,IAAIA,KAAI,IAAK,UAAU,EAAE,IAAI,CAACa,OAAO,CAACC,IAAI,CAAC;QAAEC,IAAI,EAAE;MAAW,CAAC,CAAC;MAEhE,IAAIf,KAAI,IAAK,OAAO,EAClBN,MAAM,CAACsB,IAAI,CAAC,8CAA8C,CAAC;MAE7D,IAAIhB,KAAI,IAAK,WAAW,EAAE,IAAI,CAACa,OAAO,CAACC,IAAI,CAAC;QAAEC,IAAI,EAAE;MAAY,CAAC,CAAC;IACpE;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDepend