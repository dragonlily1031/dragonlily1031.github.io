{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport MtToolbar from \"@/components/MtToolbar.vue\";\n//import MtCard from \"@/components/MtCard.vue\";\n\nexport default {\n  components: {\n    MtToolbar\n    //MtCard,\n  },\n  props: {\n    //\n  },\n  data: () => ({\n    height: 0,\n    width: 0,\n    pageHeight: 0,\n    pageWidth: 0,\n    menus: [{\n      title: \"Hotel\",\n      url: \"https://cdn.vuetifyjs.com/images/cards/plane.jpg\"\n    }, {\n      title: \"Emergency\",\n      url: \"https://cdn.vuetifyjs.com/images/cards/plane.jpg\"\n    }]\n  }),\n  mounted: async function () {\n    this.onResize();\n  },\n  computed: {\n    viewHeight: function () {\n      const toolberHeight = 64;\n      const toolberMargin = 8;\n      return this.pageHeight - toolberHeight - toolberMargin;\n    }\n  },\n  methods: {\n    onResize: function () {\n      this.height = window.innerHeight;\n      this.width = window.innerWidth;\n      this.pageHeight = window.innerHeight - 12; // 上下6pxずつ取ってる\n      this.pageWidth = window.innerWidth - 12; // 左右6pxずつ取ってる\n    },\n    execute: function (title) {\n      if (title == \"Schedule\") this.$router.push({\n        name: \"schedule\"\n      });\n      if (title == \"Hotel\") window.open(\"https://www.miyakohybridhotel.com/miyako-jp/\");\n      if (title == \"Emergency\") this.$router.push({\n        name: \"emergency\"\n      });\n    }\n  }\n};","map":{"version":3,"names":["MtToolbar","components","props","data","height","width","pageHeight","pageWidth","menus","title","url","mounted","onResize","computed","viewHeight","toolberHeight","toolberMargin","methods","window","innerHeight","innerWidth","execute","$router","push","name","open"],"sources":["C:\\work\\my-trip\\src\\pages\\MtHomePage.vue"],"sourcesContent":["<!-- MtHomePage.vue -->\r\n<template>\r\n  <div\r\n    v-if=\"isInitialized\"\r\n    v-resize=\"onResize\"\r\n    style=\"height: 100%; width: 100%; overflow: hidden\"\r\n  >\r\n    <MtToolbar title=\"Home\" :elevation=\"6\" isHome></MtToolbar>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport MtToolbar from \"@/components/MtToolbar.vue\";\r\n//import MtCard from \"@/components/MtCard.vue\";\r\n\r\nexport default {\r\n  components: {\r\n    MtToolbar,\r\n    //MtCard,\r\n  },\r\n  props: {\r\n    //\r\n  },\r\n  data: () => ({\r\n    height: 0,\r\n    width: 0,\r\n    pageHeight: 0,\r\n    pageWidth: 0,\r\n\r\n    menus: [\r\n      {\r\n        title: \"Hotel\",\r\n        url: \"https://cdn.vuetifyjs.com/images/cards/plane.jpg\",\r\n      },\r\n      {\r\n        title: \"Emergency\",\r\n        url: \"https://cdn.vuetifyjs.com/images/cards/plane.jpg\",\r\n      },\r\n    ],\r\n  }),\r\n  mounted: async function () {\r\n    this.onResize();\r\n  },\r\n  computed: {\r\n    viewHeight: function () {\r\n      const toolberHeight = 64;\r\n      const toolberMargin = 8;\r\n      return this.pageHeight - toolberHeight - toolberMargin;\r\n    },\r\n  },\r\n  methods: {\r\n    onResize: function () {\r\n      this.height = window.innerHeight;\r\n      this.width = window.innerWidth;\r\n      this.pageHeight = window.innerHeight - 12; // 上下6pxずつ取ってる\r\n      this.pageWidth = window.innerWidth - 12; // 左右6pxずつ取ってる\r\n    },\r\n    execute: function (title) {\r\n      if (title == \"Schedule\") this.$router.push({ name: \"schedule\" });\r\n\r\n      if (title == \"Hotel\")\r\n        window.open(\"https://www.miyakohybridhotel.com/miyako-jp/\");\r\n\r\n      if (title == \"Emergency\") this.$router.push({ name: \"emergency\" });\r\n    },\r\n  },\r\n};\r\n</script>\r\n"],"mappings":";AAYA,OAAOA,SAAQ,MAAO,4BAA4B;AAClD;;AAEA,eAAe;EACbC,UAAU,EAAE;IACVD;IACA;EACF,CAAC;EACDE,KAAK,EAAE;IACL;EAAA,CACD;EACDC,IAAI,EAAEA,CAAA,MAAO;IACXC,MAAM,EAAE,CAAC;IACTC,KAAK,EAAE,CAAC;IACRC,UAAU,EAAE,CAAC;IACbC,SAAS,EAAE,CAAC;IAEZC,KAAK,EAAE,CACL;MACEC,KAAK,EAAE,OAAO;MACdC,GAAG,EAAE;IACP,CAAC,EACD;MACED,KAAK,EAAE,WAAW;MAClBC,GAAG,EAAE;IACP,CAAC;EAEL,CAAC,CAAC;EACFC,OAAO,EAAE,eAAAA,CAAA,EAAkB;IAC