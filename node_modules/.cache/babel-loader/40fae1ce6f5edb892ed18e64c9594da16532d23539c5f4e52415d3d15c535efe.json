MtCard class=\"loginWindow pa-6\" justify=\"center\">\r\n        <!-- ロゴ -->\r\n        <img :src=\"logo\" />\r\n        <!-- ログインフォーム -->\r\n        <v-form @submit.prevent=\"login\">\r\n          <MtTextField\r\n            v-model=\"account\"\r\n            label=\"account\"\r\n            prepend-icon=\"mdi-account\"\r\n            :style=\"formStyle\"\r\n          />\r\n          <MtPasswordTextField\r\n            v-model=\"password\"\r\n            label=\"password\"\r\n            :style=\"formStyle\"\r\n          />\r\n        </v-form>\r\n        <v-alert\r\n          v-if=\"errReason\"\r\n          density=\"compact\"\r\n          type=\"warning\"\r\n          :text=\"errReason\"\r\n        ></v-alert>\r\n        <v-btn\r\n          form=\"login-form\"\r\n          :loading=\"loading\"\r\n          type=\"submit\"\r\n          color=\"success\"\r\n          variant=\"elevated\"\r\n          block\r\n          :style=\"formStyle\"\r\n        >\r\n          LOGIN\r\n        </v-btn>\r\n      </MtCard>\r\n    </div>\r\n  </v-main>\r\n</template>\r\n\r\n<script>\r\nimport MtCard from \"@/components/MtCard.vue\";\r\nimport MtTextField from \"@/components/MtTextField.vue\";\r\nimport MtPasswordTextField from \"@/components/MtPasswordTextField.vue\";\r\n\r\nexport default {\r\n  components: {\r\n    MtCard,\r\n    MtTextField,\r\n    MtPasswordTextField,\r\n  },\r\n  props: {\r\n    //\r\n  },\r\n  data: () => ({\r\n    height: 0,\r\n    width: 0,\r\n    errReason: \"\",\r\n    account: \"\",\r\n    password: \"\",\r\n    loading: false,\r\n  }),\r\n  mounted: async function () {\r\n    //\r\n  },\r\n  computed: {\r\n    formStyle: function () {\r\n      return \"width: 300px; margin-bottom: 10px\";\r\n    },\r\n    logo: function () {\r\n      return process.env.BASE_URL + \"assets/logo.png\";\r\n    },\r\n  },\r\n  methods: {\r\n    login: async function () {\r\n      alert(\"login\");\r\n      this.loading = true;\r\n      let result = false;\r\n      await this.$mtapi.auth\r\n        .login(this.account, this.password)\r\n        .then((response) => (result = response.data))\r\n        .catch((err) => {\r\n          this.errReason = err.response.data.message;\r\n          alert(\"error \" + JSON.stringify(err.response.data.message));\r\n        });\r\n\r\n      if (result) {\r\n        alert(\"result\");\r\n        this.loading = false;\r\n        this.$router.push({ name: \"home\" });\r\n      } else {\r\n        location.reload();\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.mainlogin {\r\n  background: linear-gradient(-225deg, #2cd8d5 0%, #c5c1ff 50%, #ffbac3 100%);\r\n}\r\n.loginWindow {\r\n  display: inline-flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  border-radius: 12px;\r\n}\r\n.login-dialog {\r\n  opacity: 0.9;\r\n}\r\n</style>\r\n"],"mappings":";AA4CA,OAAOA,MAAK,MAAO,yBAAyB;AAC5C,OAAOC,WAAU,MAAO,8BAA8B;AACtD,OAAOC,mBAAkB,MAAO,sCAAsC;AAEtE,eAAe;EACbC,UAAU,EAAE;IACVH,MAAM;IACNC,WAAW;IACXC;EACF,CAAC;EACDE,KAAK,EAAE;IACL;EAAA,CACD;EACDC,IAAI,EAAEA,CAAA,MAAO;IACXC,MAAM,EAAE,CAAC;IACTC,KAAK,EAAE,CAAC;IACRC,SAAS,EAAE,EAAE;IACbC,OAAO,EAAE,EAAE;IACXC,QAAQ,EAAE,EAAE;IACZC,OAAO,EAAE;EACX,CAAC,CAAC;EACFC,OAAO,EAAE,eAAAA,CAAA,EAAkB;IACzB;EAAA,CACD;EACDC,QAAQ,EAAE;IACRC,SAAS,EAAE,SAAAA,CAAA,EAAY;MACrB,OAAO,mCAAmC;IAC5C,CAAC;IACDC,IAAI,EAAE,SAAAA,CAAA,EAAY;MAChB,OAAOC,OAAO,CAACC,GAAG,CAACC,QAAO,GAAI,iBAAiB;IACjD;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,KAAK,EAAE,eAAAA,CAAA,EAAkB;MACvBC,KAAK,CAAC,OAAO,CAAC;MACd,IAAI,CAACV,OAAM,GAAI,IAAI;MACnB,IAAIW,MAAK,GAAI,KAAK;MAClB,MAAM,IAAI,CAACC,MAAM,CAACC,IAAG,CAClBJ,KAAK,CAAC,IAAI,CAACX,OAAO,EAAE,IAAI,CAACC,QAAQ,EACjCe,IAAI,CAAEC,QAAQ,IAAMJ,MAAK,GAAII,QAAQ,CAACrB,IAAK,EAC3CsB,KAAK,CAAEC,GAAG,IAAK;QACd,IAAI,CAACpB,SAAQ,GAAIoB,GAAG,CAACF,QAAQ,CAACrB,IAAI,CAACwB,OAAO;QAC1CR,KAAK,CAAC,QAAO,GAAIS,IAAI,CAACC,SAAS,CAACH,GAAG,CAACF,QAAQ,CAACrB,IAAI,CAACwB,OAAO,CAAC,CAAC;MAC7D,CAAC,CAAC;MAEJ,IAAIP,MAAM,EAAE;QACVD,KAAK,CAAC,QAAQ,CAAC;QACf,IAAI,CAACV,OAAM